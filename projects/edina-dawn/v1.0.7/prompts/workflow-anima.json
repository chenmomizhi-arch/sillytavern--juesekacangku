{
  "sourcePlugin": "st-chatu8",
  "sourceVersion": "2.8.1",
  "sourcePreset": "生图anima专用 (1)",
  "model": "anima\\【轻柔二次元】miaomiaoHarem_anima13.safetensors",
  "vae": "qwen_image_vae.safetensors",
  "sampler": "dpmpp_2m_sde_gpu",
  "scheduler": "normal",
  "steps": 25,
  "cfg": 5,
  "workflow": {
    "1": {
      "inputs": {
        "text": "%negative_prompt%",
        "clip": [
          "19",
          1
        ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "负面提示词"
      }
    },
    "2": {
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE解码"
      }
    },
    "3": {
      "inputs": {
        "clip_name": "qwen_3_06b_base.safetensors",
        "type": "qwen_image",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "加载CLIP"
      }
    },
    "4": {
      "inputs": {
        "vae_name": "%vae%"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "加载VAE"
      }
    },
    "8": {
      "inputs": {
        "width": "%width%",
        "height": "%height%",
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage",
      "_meta": {
        "title": "空Latent图像"
      }
    },
    "9": {
      "inputs": {
        "unet_name": "%MODEL_NAME%",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "UNet加载器"
      }
    },
    "10": {
      "inputs": {
        "seed": "%seed%",
        "steps": "%steps%",
        "cfg": "%cfg_scale%",
        "sampler_name": "%sampler_name%",
        "scheduler": "%scheduler%",
        "denoise": 1,
        "model": [
          "25",
          1
        ],
        "positive": [
          "25",
          0
        ],
        "negative": [
          "1",
          0
        ],
        "latent_image": [
          "8",
          0
        ]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "K采样器"
      }
    },
    "12": {
      "inputs": {
        "filename_prefix": "26_08_23/Anima",
        "images": [
          "2",
          0
        ]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "保存图像"
      }
    },
    "17": {
      "inputs": {
        "lora_name": "anima\\anima-base-1-masterpiece-v51.safetensors",
        "strength_model": 0.5,
        "strength_clip": 1,
        "model": [
          "9",
          0
        ],
        "clip": [
          "3",
          0
        ]
      },
      "class_type": "LoraLoader",
      "_meta": {
        "title": "加载LoRA"
      }
    },
    "18": {
      "inputs": {
        "lora_name": "anima\\zoda_v3_anima.safetensors",
        "strength_model": 0.3,
        "strength_clip": 1,
        "model": [
          "17",
          0
        ],
        "clip": [
          "17",
          1
        ]
      },
      "class_type": "LoraLoader",
      "_meta": {
        "title": "加载LoRA"
      }
    },
    "19": {
      "inputs": {
        "lora_name": "anima\\Hyperrealistic_Anima.safetensors",
        "strength_model": 0.15,
        "strength_clip": 1,
        "model": [
          "26",
          0
        ],
        "clip": [
          "26",
          1
        ]
      },
      "class_type": "LoraLoader",
      "_meta": {
        "title": "加载LoRA"
      }
    },
    "25": {
      "inputs": {
        "prompt": "%prompt%",
        "insert_lora": "CHOOSE",
        "opt_model": [
          "19",
          0
        ],
        "opt_clip": [
          "19",
          1
        ]
      },
      "class_type": "Power Prompt (rgthree)",
      "_meta": {
        "title": "提示词"
      }
    },
    "26": {
      "inputs": {
        "lora_name": "anima\\NXMZ_anima_style-000008.safetensors",
        "strength_model": 0.3,
        "strength_clip": 1,
        "model": [
          "18",
          0
        ],
        "clip": [
          "18",
          1
        ]
      },
      "class_type": "LoraLoader",
      "_meta": {
        "title": "加载LoRA"
      }
    }
  }
}
